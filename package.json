{
  "name": "cuidados-a-mente-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/jua": "^0.4.1",
    "@expo/ui": "~57.0.13",
    "@expo/vector-icons": "^15.1.0",
    "expo": "~57.0.0",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.14",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.7",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.22",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@prettier/plugin-xml": "3.4.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "prettier": "3.9.10",
    "prettier-plugin-java": "2.11.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backend.ps1 run",
    "backend:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backend.ps1 test",
    "backend:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backend.ps1 build",
    "typecheck": "tsc --noEmit",
    "test:integration": "node scripts/test-integration.mjs",
    "test:core": "node scripts/test-core.mjs",
    "test:api-client": "node scripts/test-api-client.mjs",
    "test:notifications": "node scripts/test-notifications.mjs",
    "test:offline": "node scripts/test-offline.mjs",
    "docs:legal": "node scripts/sync-legal-docs.mjs",
    "docs:manuals": "node scripts/atualizar-manuais.mjs",
    "docs:pdf": "python scripts/gerar-figuras-manuais.py && python scripts/generate-manual-pdfs.py",
    "docs:check": "python scripts/verificar-manuais.py",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,json,java}\" \"backend/src/**/*.java\" backend/pom.xml deploy/compose.yaml \"*.{json,js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,json,java}\" \"backend/src/**/*.java\" backend/pom.xml deploy/compose.yaml \"*.{json,js,ts}\""
  },
  "private": true
}
