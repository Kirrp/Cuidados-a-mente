{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Iniciar backend",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/backend.ps1",
        "run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Iniciar frontend web",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "web"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Iniciar aplicativo completo",
      "dependsOn": [
        "Iniciar backend",
        "Iniciar frontend web"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Testar backend",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/backend.ps1",
        "test"
      ],
      "problemMatcher": []
    }
  ]
}