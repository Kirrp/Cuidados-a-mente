# Web no próprio computador:
EXPO_PUBLIC_API_URL=http://localhost:8080/api
# Em celular físico, substitua localhost pelo IP do computador na rede local.
# O backend deve receber SERVER_ADDRESS=0.0.0.0 nesse caso.
